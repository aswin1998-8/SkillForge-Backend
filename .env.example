SECRET_KEY=change-me-in-production
DEBUG=True
DATABASE_URL=postgres://testuser@127.0.0.1:5433/skillforge
REDIS_URL=redis://127.0.0.1:6379/0

# Local defaults
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax

# --- Production (Render + Vercel) — set these in host dashboards ---
# ALLOWED_HOSTS=skillforge-backend-d907.onrender.com,localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
# Optional: allow all Vercel preview deploys
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$
# FRONTEND_URL=https://your-frontend.vercel.app
# Cross-site cookies (Vercel frontend → Render API) require BOTH:
# COOKIE_SECURE=True
# COOKIE_SAMESITE=None
# Vercel NEXT_PUBLIC_API_URL must be https:// (not http://) to avoid mixed content:
# NEXT_PUBLIC_API_URL=https://skillforge-backend-d907.onrender.com/api/v1

ACCESS_TOKEN_COOKIE_NAME=sf_access
REFRESH_TOKEN_COOKIE_NAME=sf_refresh
GOOGLE_CLIENT_ID=
# Must match frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# Google Console → OAuth Web client → Authorized JavaScript origins = your Vercel URL(s).
# Consent screen Publishing status should be "In production" for public sign-in.
ADAPTIVE_WEAK_THRESHOLD=0.4
ADAPTIVE_STRONG_THRESHOLD=0.7
ADAPTIVE_ROLLING_WINDOW=5
DIAGNOSTIC_MAX_COMPETENCY_AREAS=8
CODE_EXECUTION_ENABLED=True
CODE_EXECUTION_TIMEOUT_SECONDS=5
ALLOW_STAFF_PROGRESS_RESET=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@forgeiq.app
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
